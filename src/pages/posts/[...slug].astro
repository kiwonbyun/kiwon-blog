---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublishedPosts, type Post } from '../../utils/posts';

/*
 * 여기가 이 프로젝트의 유일한 라우팅 로직이다.
 * md 하나당 항목 하나를 반환하고, Astro가 그 개수만큼
 * dist/posts/<slug>/index.html 을 만든다.
 *
 * 파일명이 [slug]가 아니라 [...slug]인 이유:
 * post.id는 base 기준 상대경로라서, 나중에 md를 posts/2026/08/ 처럼
 * 폴더로 정리하면 '2026/08/글이름'처럼 슬래시를 품는다.
 * [slug]는 한 세그먼트만 받으므로 그때 매칭에 실패한다.
 */
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;

/*
 * render()가 마크다운을 HTML로 변환한다.
 * Content는 렌더링된 본문 컴포넌트, headings는 Sätteri가 수집한 제목 목록이다.
 * heading ID 생성이 처리기에 내장되어 있어 rehype-slug 같은 플러그인이 필요 없다.
 */
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings}>
  <Content />
</PostLayout>
