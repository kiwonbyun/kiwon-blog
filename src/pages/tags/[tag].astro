---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllTags, getPublishedPosts, type Post } from '../../utils/posts';

/*
 * 태그별 경로를 만든다.
 *
 * params.tag에는 인코딩하지 않은 원문을 넣는다. Astro가 출력 경로를 만들 때
 * 알아서 처리하므로 한글 태그도 dist/tags/회고/index.html 로 생성된다.
 * 링크 쪽(PostCard·tags/index)에서 encodeURIComponent를 쓰면
 * 브라우저가 %EC%9D%B4... 로 요청하고 서버가 디코딩해 이 파일을 찾는다.
 */
export async function getStaticPaths() {
  const tags = await getAllTags();
  const posts = await getPublishedPosts();

  return tags.map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`${tag} 태그가 달린 글 ${posts.length}개`}>
  <main class="mx-auto max-w-2xl px-6 py-10">
    <h1 class="text-2xl font-bold tracking-tight">#{tag}</h1>
    <p class="mt-1 text-sm text-slate-500">글 {posts.length}개</p>

    <ul class="mt-4 divide-y divide-slate-200 dark:divide-slate-800">
      {
        posts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-sm">
      <a href="/tags/" class="text-slate-500 hover:text-slate-900 dark:hover:text-slate-100">
        ← 전체 태그
      </a>
    </p>
  </main>
</BaseLayout>
