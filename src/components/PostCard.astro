---
import type { Post } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<article class="py-8">
  <FormattedDate date={pubDate} class="text-sm text-slate-500" />

  <h2 class="mt-1 text-xl font-bold tracking-tight">
    {/* post.id는 파일명 기반 slug. 끝 슬래시는 build.format이 'directory'라서 붙인다. */}
    <a href={`/posts/${post.id}/`} class="hover:text-slate-500 dark:hover:text-slate-400">
      {title}
    </a>
  </h2>

  <p class="mt-2 text-slate-600 dark:text-slate-400">{description}</p>

  {
    tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-slate-500">
        {tags.map((tag) => (
          <li>
            {/*
              한글 태그도 동작하도록 encodeURIComponent를 쓴다.
              화면에는 원문을 그대로 보여주고 URL만 인코딩한다.
            */}
            <a href={`/tags/${encodeURIComponent(tag)}/`} class="hover:text-slate-900 dark:hover:text-slate-100">
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
