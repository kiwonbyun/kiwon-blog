---
import { Image } from 'astro:assets';
import type { Post } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, cover } = post.data;
---

{/*
  대표 이미지가 있으면 우측에 썸네일을 둔다. 신문 기사 목록과 같은 배치로,
  이미지가 없는 글과 같은 리듬을 유지하려고 카드 형태로 바꾸지 않았다.
  items-start — 이미지가 텍스트 첫 줄(날짜)에 맞춰 위에서 시작한다.
*/}
<article class="flex items-start gap-5 py-11 sm:gap-8">
  <div class="min-w-0 flex-1">
    <FormattedDate date={pubDate} class="text-xs tracking-wide text-faint" />

    {/* 목록에서 가장 큰 요소. 날짜·설명과의 크기 차이로 위계를 만든다. */}
    <h2 class="mt-2.5 text-2xl leading-snug font-bold tracking-tight">
      {/* post.id는 파일명 기반 slug. 끝 슬래시는 build.format이 'directory'라서 붙인다. */}
      <a href={`/posts/${post.id}/`} class="transition-colors hover:text-muted">
        {title}
      </a>
    </h2>

    <p class="mt-3 leading-relaxed text-muted">{description}</p>

    {
      tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-xs text-faint">
          {tags.map((tag) => (
            <li>
              {/*
                한글 태그도 동작하도록 encodeURIComponent를 쓴다.
                화면에는 원문을 그대로 보여주고 URL만 인코딩한다.
              */}
              <a
                href={`/tags/${encodeURIComponent(tag)}/`}
                class="transition-colors hover:text-ink"
              >
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {
    cover && (
      <a href={`/posts/${post.id}/`} class="block shrink-0" tabindex="-1" aria-hidden="true">
        {/*
          width를 표시 크기(최대 176px)의 2배 이상으로 잡아 레티나에서도 선명하게 한다.
          비율은 CSS의 aspect-[4/3] + object-cover가 잡으므로 원본 비율이 달라도 된다.
          alt=""와 aria-hidden — 옆의 제목 링크와 중복이므로 보조기술에서 제외한다.
        */}
        <Image
          src={cover}
          alt=""
          width={480}
          height={360}
          layout="fixed"
          class="w-28 rounded-md border border-rule object-cover sm:w-44"
          style="aspect-ratio: 4 / 3"
        />
      </a>
    )
  }
</article>
