---
import { Image } from 'astro:assets';
import type { Post } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';
import defaultCover from '../assets/default-cover.webp';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, cover } = post.data;
const href = `/posts/${post.id}/`;

/*
 * 커버가 없는 글도 카드 모양이 무너지지 않도록 기본 이미지를 쓴다.
 * src/assets에 두고 import하는 이유 — <Image>는 ImageMetadata를 요구하고,
 * 그래야 커버 이미지들과 같은 최적화·srcset 파이프라인을 탄다.
 * public/에 두면 그냥 URL 문자열이라 이 전부가 빠진다.
 */
const coverImage = cover ?? defaultCover;
---

{/*
  대표 이미지를 카드 배경으로 깔고 글 정보를 그 위에 얹는다.

  스크림과 글자에 흰색/검정을 박아넣지 않고 팔레트 토큰(paper·ink)을 쓴다.
  토큰은 다크모드에서 값이 뒤집히므로, 라이트에서는 밝은 스크림 위 검은 글씨가
  되고 다크에서는 어두운 스크림 위 흰 글씨가 된다. 흰색을 박아두면 다크모드에서
  어두운 페이지에 하얀 카드만 형광등처럼 떠버린다.

  isolate — 스태킹 컨텍스트를 만들어 -z-10인 이미지·스크림이 카드 밖으로
  빠져나가지 않게 한다. 이게 없으면 이미지가 페이지 배경 뒤로 사라진다.

  높이를 aspect-ratio로 고정하지 않고 min-h로 잡는 이유 — 제목이 길어지면
  카드가 늘어나야 글자가 잘리지 않는다. 같은 행의 카드끼리는 grid가
  알아서 높이를 맞춰준다.
*/}
<article
  class="group relative isolate flex min-h-[300px] flex-col justify-end overflow-hidden rounded-2xl border border-rule bg-paper sm:min-h-[340px]"
>
  <Image
    src={coverImage}
    alt=""
    layout="none"
    widths={[400, 560, 760, 1024]}
    sizes="(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
    class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
  />

  {/*
    스크림. 커버가 대부분 글자 있는 스크린샷이라 이게 없으면 사진 속 글자와
    카드 글자가 겹쳐 둘 다 못 읽는다.

    범위를 글자가 놓이는 아래쪽으로 좁힌다. 위쪽에 옅게라도 깔면(전에 25%를
    남겼다) 이미지 전체에 뿌연 막이 씌워져 어떤 커버든 흐릿해 보인다.
    62% 지점에서 완전히 투명해지므로 카드 위 3분의 1은 원본 그대로 보인다.
  */}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-paper from-0% via-paper/95 via-38% to-transparent to-62%"
  >
  </div>

  <div class="p-6">
    <FormattedDate date={pubDate} class="text-xs tracking-wide text-faint" />

    <h2 class="mt-2 text-xl leading-snug font-bold tracking-tight text-ink">
      {/*
        after:absolute inset-0 — 링크의 클릭 영역을 카드 전체로 넓힌다.
        카드마다 링크가 하나만 남으므로 스크린리더가 같은 목적지를
        여러 번 읽지 않는다.
      */}
      <a href={href} class="transition-colors after:absolute after:inset-0 hover:text-muted">
        {title}
      </a>
    </h2>

    {/*
      태그는 카드에 두지 않는다. 4열까지 좁아지면 카드 폭이 300px 아래로
      내려가는데, 그 폭에서 태그까지 얹으면 제목·설명이 밀린다.
      태그는 글 상세와 /tags/ 페이지에서 계속 볼 수 있다.
    */}
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">
      {description}
    </p>
  </div>
</article>
