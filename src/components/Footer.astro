---
import { AUTHOR, GITHUB_URL } from '../consts';

// 빌드 시점의 연도. 정적 사이트라 배포할 때 고정된다.
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-rule">
  <div class="mx-auto flex max-w-2xl lg:max-w-3xl xl:max-w-5xl items-baseline justify-between px-6 py-8 text-xs text-faint">
    <p>&copy; {year} {AUTHOR}</p>

    <a
      href={GITHUB_URL}
      rel="noopener noreferrer"
      target="_blank"
      class="transition-colors hover:text-ink"
    >
      GitHub
    </a>
  </div>
</footer>
