---
import { AUTHOR, GITHUB_URL } from '../consts';

// 빌드 시점의 연도. 정적 사이트라 배포할 때 고정된다.
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 dark:border-slate-800">
  <div
    class="mx-auto flex max-w-2xl items-center justify-between px-6 py-8 text-sm text-slate-500"
  >
    <p>&copy; {year} {AUTHOR}</p>

    <a
      href={GITHUB_URL}
      rel="noopener noreferrer"
      target="_blank"
      class="hover:text-slate-900 dark:hover:text-slate-100"
    >
      GitHub
    </a>
  </div>
</footer>
