---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Post } from '../utils/posts';
import { SITE_URL } from '../consts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover } = post.data;

/* 공유 카드. src/pages/og/ 에서 빌드 때 1200x630으로 그린다. */
const ogImage = new URL(`/og/posts/${post.id}.jpg`, Astro.site ?? SITE_URL).href;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedDate={pubDate}
  updatedDate={updatedDate}
  image={ogImage}
  imageWidth={1200}
  imageHeight={630}
  imageAlt={title}
>
  <article class="mx-auto max-w-2xl lg:max-w-3xl xl:max-w-5xl px-6 py-14">
    {/*
      기사 머리. 날짜(작게) → 제목(가장 크게) → 리드(중간) 순으로
      크기를 계단처럼 떨어뜨려 읽는 순서를 만든다.
    */}
    <header class="border-b border-rule pb-10">
      <div class="flex flex-wrap items-baseline gap-x-2 text-xs tracking-wide text-faint">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                수정 <FormattedDate date={updatedDate} />
              </span>
            </>
          )
        }
      </div>

      <h1 class="mt-3.5 text-[2.125rem] leading-[1.2] font-bold tracking-tight">{title}</h1>

      {/* description을 리드 문단으로 승격시킨다. 목록 카드에서 쓰던 문장이 여기서 다시 쓰인다. */}
      <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>
    </header>

    <TableOfContents headings={headings} />

    {/*
      max-w-none으로 prose의 기본 max-width(65ch)를 해제한다.
      바깥 컨테이너의 max-w-2xl을 따르게 해서 목록 페이지와 본문 폭을 맞춘다.
    */}
    <div class="prose mt-12 max-w-none">
      <slot />
    </div>

    {
      /* 태그는 본문 뒤에 둔다. 다 읽은 뒤 관련 글로 넘어가는 자리다. */
      tags.length > 0 && (
        <footer class="mt-16 border-t border-rule pt-6">
          <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-faint">
            {tags.map((tag) => (
              <li>
                <a
                  href={`/tags/${encodeURIComponent(tag)}/`}
                  class="transition-colors hover:text-ink"
                >
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</BaseLayout>
