---
/*
 * 폰트 CSS는 global.css 안에서 @import 하지 않는다.
 * Tailwind가 @import를 인라인하면서 url(./woff2-dynamic-subset/...) 상대경로가
 * global.css 기준으로 재해석돼 깨질 수 있다. Vite가 각 CSS를 독립 처리하도록 분리.
 */
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '../consts';

interface Props {
  /** 페이지 제목. 없으면 사이트 제목만 쓴다 (홈). */
  title?: string;
  description?: string;
  /** OG 타입. 글 상세는 'article'. */
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  /**
   * 공유 카드에 쓸 이미지. **절대 URL**이어야 한다.
   * 크롤러는 페이지 맥락 없이 이 값만 보고 이미지를 가져가므로
   * 상대경로를 주면 아무것도 표시되지 않는다.
   */
  image?: string;
  /** 위 이미지의 실제 픽셀 크기. 선언과 실물이 다르면 카드 레이아웃이 어긋난다. */
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  /** 카드 목록 페이지. 헤더·푸터를 본문 폭에 맞춰 넓힌다. */
  wide?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = 'website',
  publishedDate,
  updatedDate,
  image,
  imageWidth,
  imageHeight,
  imageAlt,
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;

/*
 * Astro.site는 astro.config.mjs의 site 값(URL 객체)이다.
 * 설정을 빼먹으면 undefined가 되어 meta 태그가 상대경로로 나가므로 상수로 폴백한다.
 */
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {
      import.meta.env.DEV && (
        <script is:inline>
          {`const t = localStorage.getItem('dev-theme'); if (t) document.documentElement.dataset.theme = t;`}
        </script>
      )
    }

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* 피드 자동 발견용. 화면에는 RSS 링크를 노출하지 않는다. */}
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ko_KR" />
    {
      publishedDate && (
        <meta property="article:published_time" content={publishedDate.toISOString()} />
      )
    }
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    {
      image && (
        <>
          <meta property="og:image" content={image} />
          {/* 크기를 명시하면 크롤러가 이미지를 받기 전에 카드 레이아웃을 잡는다. */}
          {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
          {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
          <meta property="og:image:alt" content={imageAlt ?? title ?? SITE_TITLE} />
          <meta name="twitter:image" content={image} />
        </>
      )
    }

    {/*
      이미지가 있을 때만 큰 카드를 요청한다. summary_large_image로 두고 이미지가
      없으면 플랫폼에 따라 빈 영역이 남는다.
    */}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>

  <body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
    <Header wide={wide} />
    <div class="flex-1">
      <slot />
    </div>
    <Footer wide={wide} />
    {import.meta.env.DEV && <ThemeToggle />}
  </body>
</html>
