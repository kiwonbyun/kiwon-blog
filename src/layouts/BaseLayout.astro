---
/*
 * 폰트 CSS는 global.css 안에서 @import 하지 않는다.
 * Tailwind가 @import를 인라인하면서 url(./woff2-dynamic-subset/...) 상대경로가
 * global.css 기준으로 재해석돼 깨질 수 있다. Vite가 각 CSS를 독립 처리하도록 분리.
 */
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '../consts';

interface Props {
  /** 페이지 제목. 없으면 사이트 제목만 쓴다 (홈). */
  title?: string;
  description?: string;
  /** OG 타입. 글 상세는 'article'. */
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = 'website',
  publishedDate,
  updatedDate,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;

/*
 * Astro.site는 astro.config.mjs의 site 값(URL 객체)이다.
 * 설정을 빼먹으면 undefined가 되어 meta 태그가 상대경로로 나가므로 상수로 폴백한다.
 */
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* 피드 자동 발견용. 화면에는 RSS 링크를 노출하지 않는다. */}
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ko_KR" />
    {
      publishedDate && (
        <meta property="article:published_time" content={publishedDate.toISOString()} />
      )
    }
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>

  {/* flex + min-h-screen: 글이 짧아도 푸터가 화면 하단에 붙는다 */}
  <body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
    <Header />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
